# 필수: Claude API 키 (https://platform.claude.com)
ANTHROPIC_API_KEY=

# 필수: 사이트 접근 코드. 이 코드를 아는 사람만 검토 기능을 쓸 수 있습니다.
# 비워 두면 검토와 실시간 검색이 꺼집니다. 길고 추측하기 어려운 값을 쓰세요.
ACCESS_CODE=

# 선택: 관리자 페이지(/admin) 코드. 비워 두면 lib/http.js의 기본 비밀번호를 씁니다. ACCESS_CODE와 다른 값을 쓰세요.
ADMIN_CODE=

# 선택: 사용 현황과 근거 자료 수정에 쓰는 Upstash Redis.
# Vercel Marketplace로 연결하면 자동으로 들어갑니다. KV_REST_API_URL, KV_REST_API_TOKEN 이름도 인식합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택: 법제처 OPEN API 인증값(OC). 비워 두면 내장 자료실만으로 검토합니다.
LAW_OC=

# 선택: 사용할 Claude 모델. 비워 두면 claude-opus-5-5를 씁니다.
CLAUDE_MODEL=
